# GitHub's language bar counts shipped code only: test suites, development scripts and
# benchmarks are documentation to Linguist, in every language.
tests/** linguist-documentation
scripts/** linguist-documentation
benchmarks/** linguist-documentation
crates/**/tests/** linguist-documentation
crates/**/tests.rs linguist-documentation
ui/src/**/*.test.ts linguist-documentation
ui/scripts/** linguist-documentation
clients/typescript/tests/** linguist-documentation
clients/typescript/scripts/** linguist-documentation

# The control-store SQL is embedded in the binaries and checksummed; keep it LF on every checkout.
crates/sqlbuild-orchestration/src/store/*.sql text eol=lf
crates/sqlbuild-orchestration/tests/store/schema/baseline/*.sql text eol=lf

# Shell scripts run directly on the Windows runners too, where a CRLF checkout breaks them.
*.sh text eol=lf
