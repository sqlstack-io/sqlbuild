{
  "origin": "https://control.example.com",
  "subject": "orders-person",
  "invalid_tokens": [
    {"description": "issuer", "claims": {"iss": "https://other.example.com"}},
    {"description": "audience", "claims": {"aud": ["customers-control"]}},
    {"description": "nonce", "claims": {"nonce": "other-nonce"}},
    {"description": "expired", "claims": {"exp": 1}},
    {"description": "signature", "signing_key": "customers"},
    {"description": "access hash", "response": {"access_token": "customers-access"}},
    {"description": "missing token", "remove_fields": ["id_token"]}
  ],
  "ineligible_subjects": ["unknown-person", "orders-service", "absent-person"],
  "lifecycle": ["login", "browser-mismatch", "replica-callback", "replay", "disabled-person", "expired-flow"]
}
