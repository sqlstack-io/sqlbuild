# Copy to the ignored root .env; set the password and matching URL before starting PostgreSQL.
POSTGRES_PASSWORD=
SQLBUILD_CONTROL_DATABASE_URL=
DOCKER_GID=
SQLBUILD_GIT_REVISION=
# Replace this placeholder with create-location's assigned identity before starting the location.
SQLBUILD_LOCATION_ID=00000000-0000-0000-0000-000000000001
SQLBUILD_LOCATION_TOKEN=
